{
  "name": "bjj-roll",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.21"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:hooks": "sh scripts/leakcheckHook.test.sh",
    "prepare": "git config core.hooksPath .githooks || echo \"prepare: not a git repository, skipped core.hooksPath\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "78.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
