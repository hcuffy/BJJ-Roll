#!/bin/sh
# Leakcheck: block staged additions that match a pattern in the local, untracked `.leakcheck` file.
# One extended regex per line; blank lines and lines starting with `#` are skipped.
# Fails closed: a missing `.leakcheck`, or one without usable patterns, blocks the commit.
# On a match it prints the file name and the pattern's line number, never the matched text or the pattern.

repositoryRoot=$(git rev-parse --show-toplevel) || exit 1
patternFile="$repositoryRoot/.leakcheck"

if [ ! -f "$patternFile" ]; then
  echo "leakcheck: missing .leakcheck at the repo root; commit blocked." >&2
  echo "leakcheck: create it with one extended regex per line (see AGENTS.md, \"Leakcheck hook\")." >&2
  exit 1
fi

usablePatternCount=$(grep -cv -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$patternFile")
if [ "$usablePatternCount" -eq 0 ]; then
  echo "leakcheck: .leakcheck has no usable patterns; commit blocked." >&2
  echo "leakcheck: add at least one extended regex per line (see AGENTS.md, \"Leakcheck hook\")." >&2
  exit 1
fi

matchFound=0
stagedFiles=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)

while IFS= read -r stagedFile <&3; do
  [ -z "$stagedFile" ] && continue
  addedLines=$(git diff --cached --no-color --unified=0 -- "$stagedFile" | awk '/^@@/ { inHunk = 1; next } inHunk && /^\+/ { print substr($0, 2) }')
  [ -z "$addedLines" ] && continue
  lineNumber=0
  while IFS= read -r pattern || [ -n "$pattern" ]; do
    lineNumber=$((lineNumber + 1))
    if printf '%s\n' "$pattern" | grep -q -e '^[[:space:]]*$' -e '^[[:space:]]*#'; then
      continue
    fi
    if printf '%s\n' "$addedLines" | grep -Eq -e "$pattern"; then
      echo "leakcheck: $stagedFile matches pattern on line $lineNumber of .leakcheck" >&2
      matchFound=1
    fi
  done < "$patternFile"
done 3<<STAGED
$stagedFiles
STAGED

if [ "$matchFound" -ne 0 ]; then
  echo "leakcheck: commit blocked. Remove the matching content and stage again." >&2
  exit 1
fi

exit 0
