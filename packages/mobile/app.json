{
  "expo": {
    "name": "BJJ Roll",
    "slug": "bjj-roll",
    "version": "0.0.0",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111313",
    "scheme": "bjjroll",
    "ios": {
      "bundleIdentifier": "com.bjj.roll",
      "usesAppleSignIn": true,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSFaceIDUsageDescription": "BJJ Roll uses Face ID to unlock the app when you turn on biometric unlock."
      }
    },
    "android": {
      "package": "com.bjj.roll"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      ["./plugins/withIosSplashBackground", { "backgroundColor": "#111313" }],
      ["expo-splash-screen", { "backgroundColor": "#111313" }]
    ],
    "extra": {
      "backendUrl": "http://10.0.2.2:3000",
      "socialSignIn": {
        "appleEnabled": false,
        "googleEnabled": true
      }
    }
  }
}
