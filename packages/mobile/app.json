{
  "expo": {
    "name": "BJJ Roll",
    "slug": "bjj-roll",
    "version": "0.0.0",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111313",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#111313"
    },
    "scheme": "bjjroll",
    "ios": {
      "bundleIdentifier": "com.bjj.roll",
      "usesAppleSignIn": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.bjj.roll"
    },
    "plugins": ["expo-secure-store", "expo-web-browser", "expo-apple-authentication"],
    "extra": {
      "backendUrl": "http://10.0.2.2:3000",
      "socialSignIn": {
        "appleEnabled": false,
        "googleEnabled": true
      }
    }
  }
}
