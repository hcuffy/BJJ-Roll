{
  "name": "@bjj-roll/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "bundle": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "doctor": "EXPO_DOCTOR_SKIP_DEPENDENCY_VERSION_CHECK=1 expo-doctor && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/expoVersionCheck.ts",
    "payment-guard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/paymentLinkGuard.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@bjj-roll/shared": "workspace:*",
    "@expo/ui": "~57.0.22",
    "better-auth": "1.7.7",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "57.0.4",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "expo-doctor": "1.21.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
